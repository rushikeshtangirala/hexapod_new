<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_description</name>
  <version>0.1.0</version>
  <description>
    Kinematic and dynamic description (URDF/Xacro), meshes and RViz configuration
    for the 18-DOF hexapod robot. This package contains NO executable logic.
    It is the single source of truth for the robot model, consumed by the
    simulation, control and visualisation packages.
  </description>
  <maintainer email="hexapod69420@gmail.com">Varun</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!--
      Registers this package's share directory with Gazebo's model search
      path. gazebo_ros reads these export tags and prepends them to
      GAZEBO_MODEL_PATH when its environment hook is sourced.

      Needed because sdformat rewrites package:// URIs into model:// during
      URDF to SDF conversion, and model:// is resolved against
      GAZEBO_MODEL_PATH rather than the ament index.

      ${prefix} expands to the package's install prefix, so this resolves to
      <ws>/install/hexapod_description/share, and Gazebo then finds
      model://hexapod_description/meshes/visual/coxa.stl correctly.
    -->
    <gazebo_ros gazebo_model_path="${prefix}/share"/>
    <gazebo_ros gazebo_media_path="${prefix}/share"/>
  </export>
</package>
