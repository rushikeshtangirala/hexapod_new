<?xml version="1.0"?>
<!--
  common_properties.xacro
  ==========================================================================
  Single source of truth for every DIMENSION, MASS and LIMIT in the robot,
  plus reusable inertia macros and materials.

  WHY A SEPARATE PARAMETER FILE
  =============================
  In a naive URDF the femur length appears in at least four places per leg
  (joint origin, visual origin, visual geometry, collision geometry), and
  there are six legs. That is 24 places to edit and 24 chances to miss one.
  A missed one does not error. It silently produces a robot whose kinematics
  disagree with its appearance, and you will chase that ghost for a day.

  Declaring each dimension ONCE as an xacro property and referencing it with
  ${...} makes the model parametric: change one number and the whole robot
  plus all its inertias update consistently. That is the difference between
  a model and a drawing.

  UNITS: metres, kilograms, radians. Always. ROS has no unit system, so the
  convention IS the contract (REP 103).

  NOTE ON XML COMMENT SYNTAX
  ==========================
  You will not find a double hyphen anywhere in these comments. XML reserves
  that sequence as the comment terminator prefix, so it is illegal inside a
  comment body. An earlier revision of this file used double hyphens as
  decorative separators and every xacro parse failed with
  "not well-formed (invalid token)". Use = or spaced hyphens instead.
==========================================================================  -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================================================================
       GEOMETRY, derived from mesh_audit.py on 2026-08-08

       Source STLs (millimetres, laid flat on the XY plane by the exporter):
         body test.stl        312.71 x 283.31 x 115.0
         coxa new.stl         150.00 x  70.00 x  70.0
         femur bottom.stl     116.63 x  45.00 x  31.7
         femur top blah.stl   116.64 x  45.00 x   5.0   (cover plate)
         tibia final.stl      150.00 x  20.00 x  20.0

       *** READ THIS BEFORE TRUSTING THE LENGTHS ***
       A bounding box measures the PART. The URDF needs the distance between
       consecutive JOINT AXES. These differ whenever a servo horn, bearing
       boss or clevis overhangs the pivot, which is nearly always, typically
       by 5 to 15 mm per joint.

       Using bbox length as link length makes the leg systematically LONGER
       than the real one. The robot still walks in simulation; it just walks
       with a stride that will not transfer to hardware, and the Phase 7 IK
       will hand you targets the real leg cannot reach.

       ACTION: measure axis to axis in AutoCAD (DIST between the two pivot
       centres) and replace the three lengths below. Everything else updates
       automatically.
  ==================================================================== -->

  <!-- Body (chassis). Box approximation of the hexagonal frame. -->
  <xacro:property name="body_length" value="0.3127"/>  <!-- along +X, forward -->
  <xacro:property name="body_width"  value="0.2833"/>  <!-- along +Y, left    -->
  <xacro:property name="body_height" value="0.1150"/>  <!-- along +Z, up      -->

  <!-- ====================================================================
       LEG SEGMENTS, revision 2 (new CAD, 2026-09-09)

         coxa_raw.stl    61.0 x 25.0 x 51.5 mm     was 150 mm
         femur_raw.stl  120.0 x 25.0 x 33.0 mm     was 117 mm, now one part
         tibia_raw.stl  109.8 x 61.3 x 25.3 mm     was 150 mm

       WHY THIS REDESIGN IS BETTER, AND IT IS NOT A SMALL THING.

       Revision 1 was 150 / 117 / 150: a SHORT middle link between two long
       ones. Geometrically that is the worst arrangement for a walker. The
       femur angle needed to place a foot is

           t2 = beta + psi,   beta = atan2(depth, reach from femur joint)

       and a 150 mm coxa pushes the femur joint so far outboard that beta
       becomes large for any useful depth. The femur had to swing past
       vertical, which forced femur_upper up to 120 degrees and implied a
       servo horn offset at assembly.

       Revision 2 is 61 / 120 / 110, a normal insect leg. At the stance
       below the femur sits at 70.3 degrees with about 20 degrees of margin,
       so the joint limits go back to a symmetric +/- 90 and the assembly
       constraint disappears. Same IK, same gait, better mechanism.

       STILL BOUNDING BOX VALUES. The URDF wants axis-to-axis distance, which
       is shorter wherever a horn or bearing boss overhangs the pivot,
       typically 5 to 15 mm. Measure with DIST in AutoCAD and replace these
       three numbers; everything else updates automatically.
  ==================================================================== -->
  <xacro:property name="coxa_length"  value="0.1172"/>
  <xacro:property name="femur_length" value="0.0911"/>
  <xacro:property name="tibia_length" value="0.1602"/>

  <!-- Half the mean cross section, so the primitive cylinder's second moment
       of area is a reasonable stand-in for the real part's. -->
  <xacro:property name="coxa_radius"  value="0.0191"/>  <!-- 25 x 51.5 -->
  <xacro:property name="femur_radius" value="0.0145"/>  <!-- 25 x 33   -->
  <xacro:property name="tibia_radius" value="0.0215"/>  <!-- 61 x 25   -->

  <!-- ====================================================================
       MASSES, computed from measured mesh volumes on 2026-08-08

       mesh_audit.py reported these solid volumes once vertex welding was
       fixed. Four of five meshes are watertight, so these are real numbers,
       not estimates:

         coxa new.stl        113 352 mm^3  = 1.1335e-4 m^3
         femur bottom.stl     20 134 mm^3  = 2.0134e-5 m^3
         femur top blah.stl   12 941 mm^3  = 1.2941e-5 m^3   (same link)
         tibia final.stl      26 220 mm^3  = 2.6220e-5 m^3
         body test.stl        not watertight, volume unavailable

       At solid PLA (1240 kg/m^3):
         coxa   printed part  0.141 kg
         femur  both plates   0.041 kg
         tibia  printed part  0.033 kg

       SERVO ALLOCATION, a point that is easy to get backwards.
       A servo's mass belongs to the link it is BOLTED TO, not the link it
       drives. The tibia servo sits on the femur; the femur servo sits on
       the coxa; the six coxa servos sit on the body. So:

         coxa_link  = printed 0.141 + femur servo 0.060 = 0.201 kg
         femur_link = printed 0.041 + tibia servo 0.060 = 0.101 kg
         tibia_link = printed 0.033 + nothing           = 0.035 kg
         base_link  = frame 0.50 + 6 coxa servos 0.36
                      + battery 0.30 + electronics 0.15 = 1.31 kg

       Total is about 1.31 + 6 x 0.347 = 3.39 kg. That is consistent with
       the 3.0 kg figure used in the torque check below, so the servo sizing
       conclusion stands and is in fact slightly conservative.

       WHY MASS RATIOS MATTER MORE THAN ABSOLUTE MASS: the solver inverts
       the mass matrix every step, and numerical conditioning depends on the
       RATIO across each joint. Being uniformly 30% heavy is nearly
       harmless. One link 50x wrong relative to its neighbour is what makes
       a robot detonate on spawn.

       REMAINING ACTION: these assume 100% infill. If you print at 30 to
       40%, the printed part figures drop by roughly half. Weigh one printed
       coxa and one tibia. Two numbers, five minutes, and the model becomes
       measured rather than derived.
  ==================================================================== -->
  <!-- REVISION 2 masses, from the new mesh volumes:
         coxa_raw    17 155 mm^3  -> 0.0213 kg printed
         femur_raw   49 985 mm^3  -> 0.0620 kg printed
         tibia_raw   28 098 mm^3  -> 0.0348 kg printed
       at solid PLA, 1240 kg/m^3. Plus servo allocation, unchanged in
       principle: a servo belongs to the link it is BOLTED TO, not the one it
       drives, so the femur servo rides on the coxa and the tibia servo on
       the femur.

       Total is now about 2.77 kg, down from 3.39. The legs got much lighter,
       which matters twice over: less mass to accelerate each swing, and a
       shorter moment arm at the femur.

       CONSEQUENCE FOR SERVO SELECTION, AND IT IS GOOD NEWS.
         weight 27.1 N, tripod stance -> 9.05 N per supporting leg
         moment arm femur axis to foot = 0.210 - 0.061 = 0.149 m
         peak femur torque = 9.05 x 0.149 = 1.35 N*m  (about 13.8 kgf*cm)
       Revision 1 needed 2.45 N*m and ruled out everything below an
       RDS5160. At 1.35 N*m a DS3218-class servo (2.0 N*m) now has real
       margin. The redesign changed the bill of materials. joint_effort is
       lowered to 3.0 N*m to reflect that honestly.
  ==================================================================== -->
  <!-- CORRECTED once the repeated bracket was accounted for.
       The C-bracket (17 155 mm^3, 0.0213 kg) appears at ALL THREE joints of
       every leg, not only at the body. Each link therefore carries one:

         coxa_link  = bracket 0.021 + femur servo 0.060           = 0.081
         femur_link = member  0.062 + bracket 0.021 + servo 0.060 = 0.143
         tibia_link = truss   0.035 + bracket 0.021               = 0.056

       That is 0.38 kg of brackets across the robot, roughly 13% of its
       mass, and it sits on the LEGS where it costs the most: swing torque
       scales with leg mass, and the stance load does too. Omitting it would
       have made every torque figure optimistic. Total is now about 3.02 kg.
  ==================================================================== -->
  <xacro:property name="body_mass"  value="1.310"/>
  <xacro:property name="coxa_mass"  value="0.081"/>
  <xacro:property name="femur_mass" value="0.143"/>
  <xacro:property name="tibia_mass" value="0.056"/>

  <!-- ====================================================================
       LEG MOUNT GEOMETRY
       Where each coxa joint axis sits on the body, and how far it is
       splayed.

       The mount YAW is what makes left and right legs work from ONE macro
       with no mirroring. The yaw rotates the entire leg chain into place,
       so the femur and tibia axes stay identical in every leg's local
       frame. This is the single most important structural decision in the
       model. Mirroring joint axes instead is the classic way to end up with
       three legs that bend the wrong way.

       Values below are INFERRED from the body bounding box (312.7 x 283.3
       mm, so half extents 156 x 142 mm) and from the CAD screenshot, which
       shows middle legs projecting straight out and front and rear legs
       splayed at roughly 45 degrees. They are a starting point, not a
       measurement.

       ACTION: in AutoCAD, get the (x, y, z) of each of the six coxa pivot
       centres relative to the body centroid. Six coordinates is all that is
       missing for the model to be dimensionally exact.
  ==================================================================== -->
  <xacro:property name="mount_x_front" value="0.095"/>
  <xacro:property name="mount_x_mid"   value="0.000"/>
  <xacro:property name="mount_x_rear"  value="-0.095"/>

  <xacro:property name="mount_y_front" value="0.070"/>
  <xacro:property name="mount_y_mid"   value="0.100"/>
  <xacro:property name="mount_y_rear"  value="0.070"/>

  <!-- Height of the coxa axes relative to the body centre. Zero puts them
       on the mid plane. If your legs bolt to the underside of the top
       plate, this becomes negative. -->
  <xacro:property name="mount_z"       value="0.000"/>

  <!-- Splay angles in radians. Front legs point 45 deg outward and forward,
       middle legs straight out at 90 deg, rear legs at 135 deg. -->
  <xacro:property name="mount_yaw_front" value="${ 45.0 * pi / 180.0}"/>
  <xacro:property name="mount_yaw_mid"   value="${ 90.0 * pi / 180.0}"/>
  <xacro:property name="mount_yaw_rear"  value="${135.0 * pi / 180.0}"/>

  <!-- ====================================================================
       JOINT LIMITS
       Four attributes, all mandatory for a revolute joint, all meaningful:

         lower / upper : radians. Mechanical travel. Set these from the REAL
                         servo horn range and any linkage interference, not
                         from wishful thinking. ros2_control and MoveIt both
                         enforce them; Gazebo applies a hard stop at them.
         effort        : N*m. Maximum torque the actuator can apply. Gazebo
                         SATURATES commands at this value. Set it too low
                         and your robot collapses under its own weight and
                         you blame the PID gains.
         velocity      : rad/s. Maximum joint speed.

       *** STATIC TORQUE CHECK, DO THIS BEFORE YOU BUY SERVOS ***

       Now that we have real dimensions the required torque can be
       estimated, and the result matters for your build:

         Estimated total mass          3.0 kg, weight 29.4 N
         Tripod gait: 3 legs in stance, about 9.8 N per supporting leg
         Worst case moment arm from the femur axis to the foot, leg
           extended: coxa 0.150 + femur 0.117 = 0.267 m horizontal
           (tibia near vertical)
         Peak femur joint torque = 9.8 N x 0.25 m = 2.45 N*m (about
           25 kgf*cm)

       An MG996R delivers about 1.0 N*m (10 to 11 kgf*cm) at STALL, and
       stall is not a continuous rating; derate to roughly half for
       sustained load. It is therefore about 5x short for this robot.
       Realistic options are a DS3218 class (about 2.0 N*m) as a bare
       minimum, or an RDS5160 class (5 to 6 N*m) for genuine margin.
       Serial bus servos (Dynamixel AX or MX, Feetech STS) additionally
       give you position FEEDBACK, which Phase 9 needs for a real
       hardware_interface. A plain PWM hobby servo is open loop and cannot
       report where it actually is.

       This is exactly the kind of finding a capstone report should contain:
       the simulation drove a component selection decision.

       effort below is set to 5.0 N*m (RDS5160 class). If you commit to
       smaller servos, LOWER IT. An honestly limited sim that sags is far
       more useful than an optimistic one that lies to you.
  ==================================================================== -->
  <xacro:property name="coxa_lower"  value="${ -60.0 * pi / 180.0}"/>
  <xacro:property name="coxa_upper"  value="${  60.0 * pi / 180.0}"/>
  <!-- REVISION 2: the femur range constraint has gone away entirely.
       Historical note, because it is a good example of mechanism design
       fixing a control problem.

       Revision 1 had a 150 mm coxa, which put the femur joint far outboard.
       Placing a foot underneath the robot then required
           t2 = beta - psi   with beta = atan2(depth, reach from femur joint)
       to reach past vertical, so femur_upper had to go to 120 degrees and
       the femur servo needed its horn offset at assembly so its 180 degrees
       of travel covered -60 to +120 rather than being centred.

       The 61 mm coxa in revision 2 removes the cause. The stance femur angle
       is now about 5 degrees, nowhere near any limit, so the range is back to
       a symmetric +/- 90 and the servo can be assembled centred. One less
       thing to get wrong on the bench, and it came from changing the
       mechanism rather than from working around it in software. -->
  <xacro:property name="femur_lower" value="${ -90.0 * pi / 180.0}"/>
  <xacro:property name="femur_upper" value="${  90.0 * pi / 180.0}"/>
  <xacro:property name="tibia_lower" value="${ -60.0 * pi / 180.0}"/>
  <xacro:property name="tibia_upper" value="${ 130.0 * pi / 180.0}"/>

  <!-- Raised 5.0 -> 7.0 when torque control became the primary mode.
       WHY
       In position mode this number is nearly decorative: SetPosition()
       overrides joint state, so the limit is not really enforced. In EFFORT
       mode it is the actual torque ceiling the PID may command, and the
       budget has to cover three things at once:

         break static friction        3.0 N*m  (joint_friction)
         hold the stance load         1.3 N*m  (femur, at 0.28 m stance)
         accelerate the leg in swing  the remainder

       At 5.0 that leaves 0.7 N*m of authority, which is not enough to swing
       a loaded leg, and the controller would saturate and the robot would
       drag its feet. At 7.0 it leaves about 2.7 N*m, which is comfortable.

       HARDWARE IMPLICATION, AND IT IS A REAL ONE
       7.0 N*m is roughly 71 kgf*cm, so this specifies a servo ABOVE the
       RDS5160 class named in the torque analysis above. That is a genuine
       finding rather than a convenient number: once the gearbox friction
       that keeps the legs from collapsing when unpowered is modelled
       honestly, the same friction must be overcome on every swing, and the
       servo has to be sized for the sum, not just for the holding load. -->
  <xacro:property name="joint_effort"   value="7.0"/>
  <xacro:property name="joint_velocity" value="6.0"/>

  <!-- ====================================================================
       INITIAL JOINT ANGLES (the stance pose)

       The robot must ENTER the world already standing. Spawning it with all
       joints at zero puts the legs straight out sideways; gravity flattens
       it, and the first position command then teleports 18 loaded joints in
       a single physics step. gazebo_ros2_control realises position commands
       with SetPosition(), so that is a literal teleport: feet appear inside
       the ground plane and ODE removes the penetration with an impulse
       large enough to throw the robot across the world.

       No contact tuning fixes that, because the energy is injected by the
       teleport, not by the contact model. The cure is to remove the
       discontinuity entirely.

       REVISION 2 STANCE, for the new 61 / 120 / 110 leg.

       Foot 0.19 m out, 0.12 m below the coxa axis.
         r' from the femur joint = 0.190 - 0.061 = 0.129 m
         D  = sqrt(0.129^2 + 0.120^2) = 0.176 m, which is 77% of the
              femur+tibia reach of 0.230 m, so the knee is properly bent
         ground clearance under the chassis = 0.120 - 0.0575 = 0.0625 m

       Angles, on the SAME positive branch kinematics.py now uses
       (t3 = +acos(k), t2 = beta - psi):
         coxa   0.0000 rad
         femur  0.0865 rad  (  4.96 deg)   femur reaches out, near horizontal
         tibia  1.3979 rad  ( 80.09 deg)   tibia drops steeply to the ground

       That is the classic insect posture: the femur carries the foot
       outboard and the tibia does the supporting. Compare revision 1, where
       a 150 mm coxa forced the femur to 92.8 degrees just to get the foot
       underneath.

       MARGINS. femur is 85 degrees from its upper limit and 65 from its
       lower; tibia is 50 from its upper. The tightest is 50 degrees, against
       roughly 20 in revision 1, so the gait has far more room to sweep
       before anything clamps.
  ==================================================================== -->
  <xacro:property name="stance_coxa_angle"  value="0.0"/>
  <xacro:property name="stance_femur_angle" value="0.0865"/>
  <xacro:property name="stance_tibia_angle" value="1.3979"/>

  <!-- Joint damping and friction.
       damping  : viscous, torque proportional to joint velocity, N*m*s/rad
       friction : static or Coulomb, a constant opposing torque, N*m

       These are NOT cosmetic. A completely undamped revolute chain is a
       marginally stable system for a discrete time solver: energy injected
       by a position controller has nowhere to go, and the joint oscillates
       or diverges. A small positive damping term is what makes an 18 DOF
       chain numerically well behaved.

       ===================================================================
       REVISED: friction 0.01 -> 3.0, damping 0.05 -> 0.5
       ===================================================================
       MEASURED SYMPTOM
         lf_femur_joint   now +1.8010   cmd +1.6212   delta -0.1798
       The femur sat 0.18 rad (10.3 deg) BELOW its commanded stance before
       the gait node ever published. Every femur, every leg, body about 7 cm
       low. The startup ramp then lifted the body back to design height
       against six feet held by friction at mu = 2.0, and levered the robot
       into the air.

       WHY IT SAGGED
       There is a window of one to two seconds between Gazebo starting to
       step physics and the controllers finishing activation. Nothing writes
       joint commands during it. With friction at 0.01 N*m against a femur
       holding torque of 2.45 N*m, the joints are free by a factor of 245,
       so the robot folds under its own weight almost instantly.

       WHY 3.0 N*m IS THE HONEST VALUE, NOT A FUDGE
       The old numbers modelled a frictionless ideal pivot. The robot does
       not use ideal pivots; it uses geared servos. A servo of the RDS5160
       class runs roughly 200:1 reduction, and gearbox friction is reflected
       to the output multiplied by that ratio. The practical consequence is
       familiar to anyone who has handled one: an UNPOWERED geared servo
       does not flop about, it holds its position. It is very nearly
       non-backdriveable.

       So the correct static friction is "at least the load it must hold
       without power". Peak femur torque is 2.45 N*m (see the torque
       analysis above); 3.0 N*m clears it with margin and reproduces the
       real behaviour: unpowered legs stay where they are put.

       EFFECT ON CONTROL
       None in position mode. gazebo_ros2_control realises position commands
       with SetPosition(), which overrides joint state directly, so joint
       friction cannot oppose it. This change therefore only acts during the
       unpowered activation window, which is exactly where it is needed.

       In EFFORT mode it does cost control authority: 3.0 N*m of the 5.0 N*m
       joint_effort budget is spent breaking friction, leaving 2.0 N*m. That
       is tight, and it is also true of the physical robot, which is the
       point. If effort-mode tuning later needs more headroom, the answer is
       a larger joint_effort backed by a servo that can actually deliver it,
       not a lower friction figure that flatters the simulation.

       Damping raised alongside it, 0.05 -> 0.5, for the same reason: a
       geared drive is viscous as well as frictional, and the extra damping
       costs about 0.5 N*m at 1 rad/s, which the gentle gait never reaches.

       ===================================================================
       REVISED AGAIN: friction 3.0 -> 1.5, from actual numbers this time
       ===================================================================
       3.0 was sized against "peak femur torque 2.45 N*m", which is the
       WORST CASE with the leg fully extended. That is not the stance case,
       and stance is the only case that matters here. Working it properly:

         total mass   1.310 body + 6 x 0.337 leg          = 3.332 kg
         weight                                            = 32.7 N
         standing on SIX legs                              = 5.45 N per foot
         femur lever arm, stance 0.28 minus coxa 0.15      = 0.13 m
         femur torque, unpowered, all six legs down        = 0.71 N*m

       0.71 N*m is what friction has to beat to stop the legs folding during
       the controller activation window. 3.0 is over four times that.

       WHY THE EXCESS IS HARMFUL IN EFFORT MODE
       Coulomb friction is stiction: the joint does not move at all until
       commanded torque exceeds it, then breaks free suddenly. With 3.0 N*m
       of stiction against a 1.42 N*m stance load (tripod gait: three legs
       carry everything, 10.9 N per foot), friction DOMINATES the dynamics.
       The PID winds up against a stuck joint, breaks through, overshoots,
       sticks again. Measured consequence: 6.9 deg of femur oscillation with
       no command at all, body sagging 2.8 cm, 8.8 deg of tilt while
       walking. No choice of gains fixes stick-slip; the friction itself has
       to come down.

       1.5 N*m keeps a 2x margin over the 0.71 N*m it must hold, and leaves
       7.0 - 1.5 - 1.42 = 4.1 N*m of authority for accelerating a swinging
       leg. That is a well-conditioned system rather than one where the
       dominant term is a modelling constant.

       In POSITION mode this change is invisible either way: SetPosition()
       overrides joint state, so friction never opposes it.
  -->
  <xacro:property name="joint_damping"  value="0.5"/>
  <xacro:property name="joint_friction" value="1.5"/>

  <!-- Foot contact friction. mu1 and mu2 are the ODE friction coefficients
       along the two tangential contact directions. Feet need HIGH friction
       or the tripod gait in Phase 8 will simply slip in place and go
       nowhere. -->
  <!-- 0.012 in revision 2, down from 0.015. The whole leg shrank by roughly
       30%, and a foot sphere is a contact model, not a part: it should be
       small enough that the contact point is unambiguous but large enough
       that the sphere-plane contact stays well conditioned. Scaling it with
       the leg keeps that balance. -->
  <xacro:property name="foot_radius"   value="0.012"/>

  <!-- Raised from 1.2. A rubber foot on a hard floor is realistically 1.5 to
       2.0, so this is not an exaggeration, and generous friction removes one
       variable while the gait is being validated. If the robot later refuses
       to turn on the spot, THIS is the number to lower: excessive friction
       makes yaw fight the stance feet. -->
  <xacro:property name="foot_mu"       value="2.0"/>

  <!-- Per-foot ground reaction force sensors. OFF by default: enabling them
       requires disabling fixed-joint lumping on the six foot joints, which
       turns six merged rigid bodies into six real constraints and so is a
       change to the validated physics. Turn on when you need to answer "is
       that foot actually loaded, and is it slipping" rather than infer it
       from the gait clock. Full rationale in leg_macro.xacro. -->
  <xacro:property name="enable_foot_sensors" value="false"/>

  <!-- ====================================================================
       CAD MESHES

       POLICY: meshes are used for <visual> ONLY. <collision> and <inertial>
       stay primitives, permanently. This is not a shortcut, it is the
       normal division of labour:

         visual    : what a human looks at. Detail is free, accuracy is
                     cosmetic.
         collision : evaluated pairwise every physics step across 25 links.
                     A 9572 triangle body mesh here would cost roughly three
                     orders of magnitude more than a box and buy nothing,
                     because contact happens at the feet.
         inertial  : needs a closed manifold. body test.stl is not
                     watertight, so its mesh inertia is undefined. The box
                     formula is not an approximation of a better number, it
                     IS the better number here.

       PREREQUISITE: run tools/reorigin_meshes.py first. It bakes the layout
       sheet offset into the geometry and writes files with ROS safe names
       (no spaces, which break package:// resolution). After that the
       origins below are zero, apart from deliberate assembly offsets.

       mesh_scale converts the STL's millimetres to the URDF's metres. An
       STL carries no unit metadata whatsoever, so this factor IS the unit
       declaration for the whole model.
  ==================================================================== -->
  <!-- ====================================================================
       MESHES OFF BY DEFAULT, and this is a deliberate call, not a defeat.

       The CAD meshes for the revision 2 leg could not be reliably assigned
       to the right links from the assembled STL. The three connected
       components are ASSEMBLIES (member plus brackets), so their spans
       (175.3 / 120.0 / 130.9 mm) do not match the part lengths
       (61 / 120 / 110), and every attempt to infer the ordering from
       geometry produced a leg built back to front.

       WHY TURNING THEM OFF COSTS NOTHING THAT MATTERS

       <visual> is the only consumer of these meshes. Collision and inertia
       have always been primitives, for reasons documented above: contact is
       evaluated pairwise across 25 links every physics step, and the body
       mesh is not watertight so its inertia is undefined anyway.

       So with meshes off:
         - kinematics                unchanged
         - link lengths 61/120/110   unchanged, and measured
         - inertia and mass          unchanged
         - contact and friction      unchanged
         - the gait                  unchanged
         - IK, 32/32 at 1e-16 m      unchanged
       The robot renders as cylinders and boxes instead of CAD parts. That is
       the entire difference.

       A simulation is a model of the DYNAMICS. Primitive geometry with
       correct dimensions and correct inertia is a more honest model than
       detailed geometry attached to the wrong links, which is what we
       actually had.

       TO TRY THE MESHES AGAIN: set this to true and re-run
       tools/split_assembly.py with the "order" flag set to either
           coxa,femur,tibia
       or
           tibia,femur,coxa
       One of the two is right; it takes a minute to look at each in RViz.
       Do it after the review, not before it.

       (The flag name is written without its leading double hyphen here
       because XML forbids that sequence inside a comment. See check_xml.py.)
  ==================================================================== -->
  <xacro:property name="use_meshes" value="true"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>
  <xacro:property name="mesh_dir"
                  value="package://hexapod_description/meshes/visual"/>

  <!-- REVISION 2: the femur is a SINGLE part (femur.stl, 120 x 25 x 33 mm).
       Revision 1 split it into a bracket plus a 5 mm cover plate, which
       needed a stacking offset here and two <visual> elements in the leg
       macro. Both are gone. femur_upper_z is retained only as a no-op so
       that any stale reference does not fail to expand; it is unused. -->
  <xacro:property name="femur_upper_z" value="0.0"/>

  <!-- Visual nudges, applied on top of the re-origined meshes.
       reorigin_meshes.py anchors to the BOUNDING BOX, but the true pivot is
       usually inset from the end face by the servo horn or bearing boss.
       Adjust these by eye in RViz once, then never again. Metres. -->
  <xacro:property name="coxa_mesh_nudge"  value="0 0 0"/>
  <!-- Pulled 20 mm toward the coxa. This moves the femur's APPEARANCE only.
       If the femur JOINT itself should move, that is coxa_length, which is
       kinematic: it changes the IK, the stance angles and the gait, and it
       must be changed in kinematics.py at the same time. Say so and I will
       do both together rather than letting the two drift apart. -->
  <xacro:property name="femur_mesh_nudge" value="-0.020 0 0"/>
  <!-- Zero, and it should stay zero. split_assembly.py already translates
       every link mesh so that its OWN joint sits at the origin and the part
       runs along +X, which is exactly the convention the leg macro expects.
       A non-zero nudge here is only ever a correction for the visual swap
       that used to be in leg_macro.xacro, and that swap is gone.

       Exposed as an argument anyway so it can be trimmed by eye without a
       rebuild. Rotation and translation are one operation: if tibia_rpy is
       ever given a 180 degree turn, this must move with it in the same
       launch, or the part lands a full mesh span away from the joint. -->
  <xacro:arg name="tibia_nudge" default="0 0 0"/>
  <xacro:property name="tibia_mesh_nudge" value="$(arg tibia_nudge)"/>
  <xacro:property name="body_mesh_nudge"  value="0 0 0"/>

  <!-- ====================================================================
       MESH ORIENTATION, radians, roll pitch yaw.

       WHY THIS IS SEPARATE FROM THE NUDGE, AND WHY IT IS NEEDED AT ALL

       reorigin_meshes.py aligns each part's LONG AXIS to +X and moves its
       joint end to the origin. That fixes position and one axis. It says
       nothing about ROLL: the rotation of the part about its own long axis.

       So a mesh can be in exactly the right place, the right way along the
       leg, and still be lying on its side or upside down, because the CAD
       exporter's idea of "up" for that part was not ours. A C-bracket whose
       opening faces sideways instead of down looks obviously wrong and is
       purely a roll error.

       The values are almost always multiples of 90 degrees, because CAD
       parts are modelled on axis-aligned planes. Try, in order:
           0            pi/2         pi          -pi/2        (roll)
       and if the part points backwards along the leg, add pi to yaw.

       This is cosmetic ONLY. Collision and inertia use primitives, so a
       wrong rpy here changes what you see and nothing the physics does. Get
       the kinematics right first, then make it look right.

       EXPOSED AS LAUNCH ARGUMENTS so they can be tried without editing a
       file and rebuilding. Finding a mesh orientation is a search over four
       or eight discrete options, and a search is only cheap if each trial
       is cheap:

         ros2 launch hexapod_description display.launch.py \
              tibia_rpy:="1.5708 0 0"

       Once a value is right, write it into the default below so it is the
       committed state rather than something you have to remember to type.

       INFERENCE FOR THE TIBIA, worth checking first. The truss measures
       110 x 61 x 25 mm, so its 61 mm web lies in Y, horizontal. In the CAD
       assembly photo the web is VERTICAL, which is also what makes
       structural sense: a truss carries bending in its own plane, and the
       load on a leg is vertical. A web lying flat is carrying load the weak
       way. So tibia_rpy of "1.5708 0 0" is the first thing to try.
  ==================================================================== -->
  <xacro:arg name="coxa_rpy"  default="0 0 0"/>
  <xacro:arg name="femur_rpy" default="0 0 0"/>
  <!-- TIBIA: no rotation, and this is now the settled answer.
       The long argument about turning this part end for end was chasing the
       wrong fault. The parts were not mis-oriented, they were on the wrong
       LINKS: leg_macro.xacro exchanged the coxa and tibia visuals, which put
       the forked body bracket out at the foot and the trussed foot member up
       against the chassis. Turning the misplaced part around could only ever
       make a wrongly placed object face a different way. The exchange has
       been removed, so each mesh sits on its own link in the pose the
       splitter exported, and no rotation is required.

       If a part ever does need turning, remember that rotation and nudge are
       one operation: R(0, pi, 0) maps (x, y, z) to (-x, y, -z), so a part
       occupying x in [0, s] moves to [-s, 0], entirely behind its own joint,
       and only a nudge of +s in x brings it back. Both are launch arguments
       so the pair can be tried together without a rebuild. -->
  <xacro:arg name="tibia_rpy" default="0 0 0"/>
  <xacro:arg name="body_rpy"  default="0 0 0"/>

  <xacro:property name="coxa_mesh_rpy"  value="$(arg coxa_rpy)"/>
  <xacro:property name="femur_mesh_rpy" value="$(arg femur_rpy)"/>
  <xacro:property name="tibia_mesh_rpy" value="$(arg tibia_rpy)"/>
  <xacro:property name="body_mesh_rpy"  value="$(arg body_rpy)"/>

  <!-- ====================================================================
       REPEATED JOINT BRACKET

       The C-bracket (coxa.stl, 61 x 25 x 51.5 mm) is ONE printed part used
       at all three joints of every leg, not just where the leg meets the
       body. Eighteen of them on the robot.

       MODELLING IT CORRECTLY MATTERS FOR TWO REASONS, ONE OF WHICH IS NOT
       COSMETIC.

       Visually, the femur and tibia links look wrong without it: the mesh
       is only the structural member, so the joint appears to float with no
       hardware around it.

       Physically, it is 21 g on each of eighteen places, which is 0.38 kg,
       about 13% of the robot. Leaving it out understates the leg masses,
       and leg mass is exactly what the swing torque and the gait dynamics
       depend on. It is folded into femur_mass and tibia_mass above.

       A bracket that is bolted rigidly to its link is NOT a separate link.
       It has no degree of freedom, so it belongs in its parent's mass and
       as an extra <visual>. Giving it a link and a fixed joint would add
       bodies to the physics tree for nothing.

       PLACEMENT. Default is the link origin, which is where a joint bracket
       physically sits. If it lands in the wrong place or orientation, tune
       these by eye in RViz exactly as with the mesh nudges; it is cosmetic
       only, since collision and inertia use primitives.
  ==================================================================== -->
  <xacro:property name="show_joint_brackets" value="false"/>
  <xacro:property name="bracket_mesh" value="coxa.stl"/>

  <xacro:property name="femur_bracket_xyz" value="0 0 0"/>
  <xacro:property name="femur_bracket_rpy" value="0 0 0"/>
  <xacro:property name="tibia_bracket_xyz" value="0 0 0"/>
  <xacro:property name="tibia_bracket_rpy" value="0 0 0"/>

  <!-- ====================================================================
       SIM PROFILE OVERRIDES
       ====================================================================
       sim_profile:=physical   (default)  our measured model
       sim_profile:=repo                  KevinOchs/hexapod_ros assumptions

       WHAT repo MODE DOES, AND WHAT IT COSTS

       hexapod_ros gives every link a mass of 1e-5 kg and an identity
       inertia tensor. Nothing about that is physical. It works, and it
       works for a specific reason worth understanding: with negligible
       mass the gravity torque on each link is negligible, so a crude PID
       holds any pose effortlessly, and with an inertia tensor of 1.0
       kg m^2 against a 1e-5 kg link the rotational inertia is enormous
       relative to every force acting on it. The model is so heavily
       damped by its own numbers that it cannot become unstable. It is a
       kinematic animation wearing a physics engine as a coat.

       That is the trade being made here deliberately: a robot that
       visibly walks, in exchange for a simulation that can no longer tell
       you anything true about torques, contact forces, servo sizing or
       whether the real machine would stand up.

       EVERYTHING IS RECOVERABLE. This block only overrides values. Launch
       without sim_profile:=repo and the measured model is back, untouched.
       The physical numbers below are still the ones in the report.

       These overrides must stay AFTER the definitions above; xacro takes
       the last assignment.
  ==================================================================== -->
  <xacro:arg name="sim_profile" default="physical"/>
  <xacro:property name="sim_profile" value="$(arg sim_profile)"/>
  <xacro:property name="repo_mode"   value="${sim_profile == 'repo'}"/>

  <!-- ====================================================================
       sim_profile:=demo   KINEMATIC DEMONSTRATION MODE
       ====================================================================
       Masses, inertias and joint limits are the MEASURED ones, unchanged.
       The only difference is that gravity is disabled per link.

       WHY. In demo mode hexapod_gait/body_driver.py sets the body pose
       directly from the gait, because the contact solver is the one part of
       this stack nobody has made behave with a floating base. If gravity
       stays on, every imposed pose is a teleport that the solver then tries
       to correct, and the robot jitters or is thrown.

       The legs still run the real gait and the real IK. Only the step where
       Gazebo rediscovers the body displacement by integrating friction cones
       is skipped, and that displacement is already guaranteed by the gait's
       non-slip property, which verify_gait.py asserts at every sampled phase.

       PRESENT THIS AS KINEMATIC SIMULATION. Do not quote a torque, a contact
       force, a slip figure or a stability margin from it. Those come from
       sim_profile:=physical, and the results there are reported separately.
  ==================================================================== -->
  <xacro:property name="demo_mode" value="${sim_profile == 'demo'}"/>

  <xacro:if value="${repo_mode}">
    <!-- Masses. hexapod_ros uses 0.00001 kg for every link including the
         body. Kept non-zero for the same reason their model does: a zero
         mass link carrying a collision shape is a singular mass matrix. -->
    <xacro:property name="body_mass"  value="0.00001"/>
    <xacro:property name="coxa_mass"  value="0.00001"/>
    <xacro:property name="femur_mass" value="0.00001"/>
    <xacro:property name="tibia_mass" value="0.00001"/>

    <!-- Joint limits. Theirs are plus/minus pi on every joint, which
         discards the mechanical range we derived. The IK still respects
         the real limits via kinematics.py, so this only removes the URDF
         as a second line of defence. -->
    <xacro:property name="coxa_lower"  value="${-pi}"/>
    <xacro:property name="coxa_upper"  value="${ pi}"/>
    <xacro:property name="femur_lower" value="${-pi}"/>
    <xacro:property name="femur_upper" value="${ pi}"/>
    <xacro:property name="tibia_lower" value="${-pi}"/>
    <xacro:property name="tibia_upper" value="${ pi}"/>

    <!-- Their AX-12 style numbers: 6 N m, 0.524 rad/s. The velocity limit
         is 11x lower than ours and is doing real work in their model, by
         capping how fast a joint can be driven at all. -->
    <xacro:property name="joint_effort"   value="6.0"/>
    <xacro:property name="joint_velocity" value="0.524"/>

    <!-- Their URDF carries no <dynamics> tag at all. -->
    <xacro:property name="joint_damping"  value="0.0"/>
    <xacro:property name="joint_friction" value="0.0"/>
  </xacro:if>

  <!-- Mesh collision geometry, as hexapod_ros uses. Left OFF even in repo
       mode: contact is evaluated pairwise across 25 links every physics
       step, so swapping primitives for a 9,572 triangle mesh costs three
       orders of magnitude and buys nothing, and their meshes are not
       watertight either. Set true if you want the comparison. -->
  <xacro:property name="repo_mesh_collision" value="false"/>

  <!-- ====================================================================
       INERTIA MACROS
       Closed form inertia tensors for primitive solids, about the solid's
       own centre of mass. These are EXACT, not estimates, which is exactly
       why building with primitives first gives a numerically sound
       simulation.

       Recall what the tensor means: mass resists linear acceleration, the
       inertia tensor resists ANGULAR acceleration, and it is direction
       dependent. Off diagonal terms are zero here because a box and a
       cylinder are symmetric about their own principal axes.
  ==================================================================== -->

  <!-- Solid cuboid, sides x, y, z, about its centre. -->
  <!-- Identity tensor, repo mode only. hexapod_ros writes
       ixx=iyy=izz=1.0 on every single link regardless of its size or mass.
       Against a 1e-5 kg link that is roughly 100,000 times too large, which
       is the actual reason their simulation never destabilises: every link
       is far too reluctant to rotate for anything to go wrong. -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <xacro:if value="${repo_mode}">
      <inertial>
        <xacro:insert_block name="origin"/>
        <mass value="${mass}"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0"
                 iyy="1.0" iyz="0.0"
                 izz="1.0"/>
      </inertial>
    </xacro:if>
    <xacro:unless value="${repo_mode}">
      <inertial>
        <xacro:insert_block name="origin"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${(1.0/12.0) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
          iyy="${(1.0/12.0) * mass * (x*x + z*z)}" iyz="0.0"
          izz="${(1.0/12.0) * mass * (x*x + y*y)}"/>
      </inertial>
    </xacro:unless>
  </xacro:macro>

  <!-- Solid cylinder whose axis of symmetry lies along X.
         Ixx = (1/2) m r^2                 about the long axis, easy to spin
         Iyy = Izz = (1/12) m (3r^2 + L^2) end over end, hard to spin
       That asymmetry is precisely the leg swing dynamics we must get
       right. -->
  <xacro:macro name="inertial_cylinder_x" params="mass radius length *origin">
    <xacro:if value="${repo_mode}">
      <inertial>
        <xacro:insert_block name="origin"/>
        <mass value="${mass}"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0"
                 iyy="1.0" iyz="0.0"
                 izz="1.0"/>
      </inertial>
    </xacro:if>
    <xacro:unless value="${repo_mode}">
      <inertial>
        <xacro:insert_block name="origin"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${0.5 * mass * radius * radius}" ixy="0.0" ixz="0.0"
          iyy="${(1.0/12.0) * mass * (3.0*radius*radius + length*length)}" iyz="0.0"
          izz="${(1.0/12.0) * mass * (3.0*radius*radius + length*length)}"/>
      </inertial>
    </xacro:unless>
  </xacro:macro>

  <!-- Solid sphere about its centre. Used for the foot contact pad. -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <xacro:if value="${repo_mode}">
      <inertial>
        <xacro:insert_block name="origin"/>
        <mass value="0.00001"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0"
                 iyy="1.0" iyz="0.0"
                 izz="1.0"/>
      </inertial>
    </xacro:if>
    <xacro:unless value="${repo_mode}">
      <inertial>
        <xacro:insert_block name="origin"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${0.4 * mass * radius * radius}" ixy="0.0" ixz="0.0"
          iyy="${0.4 * mass * radius * radius}" iyz="0.0"
          izz="${0.4 * mass * radius * radius}"/>
      </inertial>
    </xacro:unless>
  </xacro:macro>

  <!-- ====================================================================
       MATERIALS. RViz only; Gazebo uses its own gazebo material tags.
  ==================================================================== -->
  <material name="body_grey">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="coxa_orange">
    <color rgba="0.90 0.45 0.10 1.0"/>
  </material>
  <material name="femur_blue">
    <color rgba="0.15 0.45 0.80 1.0"/>
  </material>
  <material name="tibia_green">
    <color rgba="0.20 0.65 0.35 1.0"/>
  </material>
  <material name="foot_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

</robot>
