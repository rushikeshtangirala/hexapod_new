<?xml version="1.0"?>
<!--
  common_properties.xacro
  ==========================================================================
  Single source of truth for every DIMENSION, MASS and LIMIT in the robot,
  plus reusable inertia macros and materials.

  WHY A SEPARATE PARAMETER FILE
  =============================
  In a naive URDF the femur length appears in at least four places per leg
  (joint origin, visual origin, visual geometry, collision geometry), and
  there are six legs. That is 24 places to edit and 24 chances to miss one.
  A missed one does not error. It silently produces a robot whose kinematics
  disagree with its appearance, and you will chase that ghost for a day.

  Declaring each dimension ONCE as an xacro property and referencing it with
  ${...} makes the model parametric: change one number and the whole robot
  plus all its inertias update consistently. That is the difference between
  a model and a drawing.

  UNITS: metres, kilograms, radians. Always. ROS has no unit system, so the
  convention IS the contract (REP 103).

  NOTE ON XML COMMENT SYNTAX
  ==========================
  You will not find a double hyphen anywhere in these comments. XML reserves
  that sequence as the comment terminator prefix, so it is illegal inside a
  comment body. An earlier revision of this file used double hyphens as
  decorative separators and every xacro parse failed with
  "not well-formed (invalid token)". Use = or spaced hyphens instead.
==========================================================================  -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================================================================
       GEOMETRY, derived from mesh_audit.py on 2026-08-08

       Source STLs (millimetres, laid flat on the XY plane by the exporter):
         body test.stl        312.71 x 283.31 x 115.0
         coxa new.stl         150.00 x  70.00 x  70.0
         femur bottom.stl     116.63 x  45.00 x  31.7
         femur top blah.stl   116.64 x  45.00 x   5.0   (cover plate)
         tibia final.stl      150.00 x  20.00 x  20.0

       *** READ THIS BEFORE TRUSTING THE LENGTHS ***
       A bounding box measures the PART. The URDF needs the distance between
       consecutive JOINT AXES. These differ whenever a servo horn, bearing
       boss or clevis overhangs the pivot, which is nearly always, typically
       by 5 to 15 mm per joint.

       Using bbox length as link length makes the leg systematically LONGER
       than the real one. The robot still walks in simulation; it just walks
       with a stride that will not transfer to hardware, and the Phase 7 IK
       will hand you targets the real leg cannot reach.

       ACTION: measure axis to axis in AutoCAD (DIST between the two pivot
       centres) and replace the three lengths below. Everything else updates
       automatically.
  ==================================================================== -->

  <!-- Body (chassis). Box approximation of the hexagonal frame. -->
  <xacro:property name="body_length" value="0.3127"/>  <!-- along +X, forward -->
  <xacro:property name="body_width"  value="0.2833"/>  <!-- along +Y, left    -->
  <xacro:property name="body_height" value="0.1150"/>  <!-- along +Z, up      -->

  <!-- Leg segment lengths. Each segment extends along its own +X axis.
       Currently bbox derived: CONFIRM AGAINST AXIS TO AXIS DISTANCE. -->
  <xacro:property name="coxa_length"  value="0.1500"/>
  <xacro:property name="femur_length" value="0.1166"/>
  <xacro:property name="tibia_length" value="0.1500"/>

  <!-- Segment radii for the primitive cylinders AND their inertia.
       Taken as half the mean cross section, so the cylinder's second moment
       of area is a reasonable stand in for the real part's. -->
  <xacro:property name="coxa_radius"  value="0.0350"/>  <!-- 70 x 70   -->
  <xacro:property name="femur_radius" value="0.0192"/>  <!-- 45 x 31.7 -->
  <xacro:property name="tibia_radius" value="0.0100"/>  <!-- 20 x 20   -->

  <!-- ====================================================================
       MASSES, computed from measured mesh volumes on 2026-08-08

       mesh_audit.py reported these solid volumes once vertex welding was
       fixed. Four of five meshes are watertight, so these are real numbers,
       not estimates:

         coxa new.stl        113 352 mm^3  = 1.1335e-4 m^3
         femur bottom.stl     20 134 mm^3  = 2.0134e-5 m^3
         femur top blah.stl   12 941 mm^3  = 1.2941e-5 m^3   (same link)
         tibia final.stl      26 220 mm^3  = 2.6220e-5 m^3
         body test.stl        not watertight, volume unavailable

       At solid PLA (1240 kg/m^3):
         coxa   printed part  0.141 kg
         femur  both plates   0.041 kg
         tibia  printed part  0.033 kg

       SERVO ALLOCATION, a point that is easy to get backwards.
       A servo's mass belongs to the link it is BOLTED TO, not the link it
       drives. The tibia servo sits on the femur; the femur servo sits on
       the coxa; the six coxa servos sit on the body. So:

         coxa_link  = printed 0.141 + femur servo 0.060 = 0.201 kg
         femur_link = printed 0.041 + tibia servo 0.060 = 0.101 kg
         tibia_link = printed 0.033 + nothing           = 0.035 kg
         base_link  = frame 0.50 + 6 coxa servos 0.36
                      + battery 0.30 + electronics 0.15 = 1.31 kg

       Total is about 1.31 + 6 x 0.347 = 3.39 kg. That is consistent with
       the 3.0 kg figure used in the torque check below, so the servo sizing
       conclusion stands and is in fact slightly conservative.

       WHY MASS RATIOS MATTER MORE THAN ABSOLUTE MASS: the solver inverts
       the mass matrix every step, and numerical conditioning depends on the
       RATIO across each joint. Being uniformly 30% heavy is nearly
       harmless. One link 50x wrong relative to its neighbour is what makes
       a robot detonate on spawn.

       REMAINING ACTION: these assume 100% infill. If you print at 30 to
       40%, the printed part figures drop by roughly half. Weigh one printed
       coxa and one tibia. Two numbers, five minutes, and the model becomes
       measured rather than derived.
  ==================================================================== -->
  <xacro:property name="body_mass"  value="1.310"/>
  <xacro:property name="coxa_mass"  value="0.201"/>
  <xacro:property name="femur_mass" value="0.101"/>
  <xacro:property name="tibia_mass" value="0.035"/>

  <!-- ====================================================================
       LEG MOUNT GEOMETRY
       Where each coxa joint axis sits on the body, and how far it is
       splayed.

       The mount YAW is what makes left and right legs work from ONE macro
       with no mirroring. The yaw rotates the entire leg chain into place,
       so the femur and tibia axes stay identical in every leg's local
       frame. This is the single most important structural decision in the
       model. Mirroring joint axes instead is the classic way to end up with
       three legs that bend the wrong way.

       Values below are INFERRED from the body bounding box (312.7 x 283.3
       mm, so half extents 156 x 142 mm) and from the CAD screenshot, which
       shows middle legs projecting straight out and front and rear legs
       splayed at roughly 45 degrees. They are a starting point, not a
       measurement.

       ACTION: in AutoCAD, get the (x, y, z) of each of the six coxa pivot
       centres relative to the body centroid. Six coordinates is all that is
       missing for the model to be dimensionally exact.
  ==================================================================== -->
  <xacro:property name="mount_x_front" value="0.095"/>
  <xacro:property name="mount_x_mid"   value="0.000"/>
  <xacro:property name="mount_x_rear"  value="-0.095"/>

  <xacro:property name="mount_y_front" value="0.070"/>
  <xacro:property name="mount_y_mid"   value="0.100"/>
  <xacro:property name="mount_y_rear"  value="0.070"/>

  <!-- Height of the coxa axes relative to the body centre. Zero puts them
       on the mid plane. If your legs bolt to the underside of the top
       plate, this becomes negative. -->
  <xacro:property name="mount_z"       value="0.000"/>

  <!-- Splay angles in radians. Front legs point 45 deg outward and forward,
       middle legs straight out at 90 deg, rear legs at 135 deg. -->
  <xacro:property name="mount_yaw_front" value="${ 45.0 * pi / 180.0}"/>
  <xacro:property name="mount_yaw_mid"   value="${ 90.0 * pi / 180.0}"/>
  <xacro:property name="mount_yaw_rear"  value="${135.0 * pi / 180.0}"/>

  <!-- ====================================================================
       JOINT LIMITS
       Four attributes, all mandatory for a revolute joint, all meaningful:

         lower / upper : radians. Mechanical travel. Set these from the REAL
                         servo horn range and any linkage interference, not
                         from wishful thinking. ros2_control and MoveIt both
                         enforce them; Gazebo applies a hard stop at them.
         effort        : N*m. Maximum torque the actuator can apply. Gazebo
                         SATURATES commands at this value. Set it too low
                         and your robot collapses under its own weight and
                         you blame the PID gains.
         velocity      : rad/s. Maximum joint speed.

       *** STATIC TORQUE CHECK, DO THIS BEFORE YOU BUY SERVOS ***

       Now that we have real dimensions the required torque can be
       estimated, and the result matters for your build:

         Estimated total mass          3.0 kg, weight 29.4 N
         Tripod gait: 3 legs in stance, about 9.8 N per supporting leg
         Worst case moment arm from the femur axis to the foot, leg
           extended: coxa 0.150 + femur 0.117 = 0.267 m horizontal
           (tibia near vertical)
         Peak femur joint torque = 9.8 N x 0.25 m = 2.45 N*m (about
           25 kgf*cm)

       An MG996R delivers about 1.0 N*m (10 to 11 kgf*cm) at STALL, and
       stall is not a continuous rating; derate to roughly half for
       sustained load. It is therefore about 5x short for this robot.
       Realistic options are a DS3218 class (about 2.0 N*m) as a bare
       minimum, or an RDS5160 class (5 to 6 N*m) for genuine margin.
       Serial bus servos (Dynamixel AX or MX, Feetech STS) additionally
       give you position FEEDBACK, which Phase 9 needs for a real
       hardware_interface. A plain PWM hobby servo is open loop and cannot
       report where it actually is.

       This is exactly the kind of finding a capstone report should contain:
       the simulation drove a component selection decision.

       effort below is set to 5.0 N*m (RDS5160 class). If you commit to
       smaller servos, LOWER IT. An honestly limited sim that sags is far
       more useful than an optimistic one that lies to you.
  ==================================================================== -->
  <xacro:property name="coxa_lower"  value="${ -60.0 * pi / 180.0}"/>
  <xacro:property name="coxa_upper"  value="${  60.0 * pi / 180.0}"/>
  <!-- femur_upper raised from 90 to 120 degrees, and this is a MECHANICAL
       requirement, not a software convenience.

       With the coxa 0.150 m long and horizontal, the femur joint sits well
       outboard of the body. To place a foot UNDERNEATH the robot rather than
       out to the side, the femur must swing past vertical. The geometry:

           t2 = beta + psi
       where beta = atan2(depth, horizontal reach from the femur joint) and
       psi is about 39 degrees for this link pair. Keeping t2 under 90 forces
       beta under about 51 degrees, i.e. depth < 1.2x horizontal reach. The
       result is a leg extended almost straight sideways, the foot barely
       below the body, and a sprawled posture that cannot support weight
       well.

       At 120 degrees the femur can point past vertical, the tibia hangs
       downward, and the robot stands properly.

       WHAT THIS MEANS FOR THE BUILD: the femur servo must be assembled with
       its horn offset so that its 180 degree travel maps to roughly -60 to
       +120 degrees in this frame, rather than centred on zero. That is a
       one-off decision at assembly. If your bracket cannot do it, lower this
       number and accept a more sprawled stance; the simulation will then
       honestly reflect the hardware. -->
  <xacro:property name="femur_lower" value="${ -60.0 * pi / 180.0}"/>
  <xacro:property name="femur_upper" value="${  90.0 * pi / 180.0}"/>
  <xacro:property name="tibia_lower" value="${ -60.0 * pi / 180.0}"/>
  <xacro:property name="tibia_upper" value="${ 130.0 * pi / 180.0}"/>

  <!-- Raised 5.0 -> 7.0 when torque control became the primary mode.
       WHY
       In position mode this number is nearly decorative: SetPosition()
       overrides joint state, so the limit is not really enforced. In EFFORT
       mode it is the actual torque ceiling the PID may command, and the
       budget has to cover three things at once:

         break static friction        3.0 N*m  (joint_friction)
         hold the stance load         1.3 N*m  (femur, at 0.28 m stance)
         accelerate the leg in swing  the remainder

       At 5.0 that leaves 0.7 N*m of authority, which is not enough to swing
       a loaded leg, and the controller would saturate and the robot would
       drag its feet. At 7.0 it leaves about 2.7 N*m, which is comfortable.

       HARDWARE IMPLICATION, AND IT IS A REAL ONE
       7.0 N*m is roughly 71 kgf*cm, so this specifies a servo ABOVE the
       RDS5160 class named in the torque analysis above. That is a genuine
       finding rather than a convenient number: once the gearbox friction
       that keeps the legs from collapsing when unpowered is modelled
       honestly, the same friction must be overcome on every swing, and the
       servo has to be sized for the sum, not just for the holding load. -->
  <xacro:property name="joint_effort"   value="7.0"/>
  <xacro:property name="joint_velocity" value="6.0"/>

  <!-- ====================================================================
       INITIAL JOINT ANGLES (the stance pose)

       The robot must ENTER the world already standing. Spawning it with all
       joints at zero puts the legs straight out sideways; gravity flattens
       it, and the first position command then teleports 18 loaded joints in
       a single physics step. gazebo_ros2_control realises position commands
       with SetPosition(), so that is a literal teleport: feet appear inside
       the ground plane and ODE removes the penetration with an impulse
       large enough to throw the robot across the world.

       No contact tuning fixes that, because the energy is injected by the
       teleport, not by the contact model. The cure is to remove the
       discontinuity entirely.

       REVISED after seeing the robot stand: the previous stance (0.34 m out,
       0.11 m down) put the leg at 86% of full extension with the tibia
       horizontal, so the feet stuck out sideways and the body barely
       cleared the ground. Legs that straight also have almost no vertical
       compliance, which is bad for both load bearing and gait.

       New stance: 0.28 m out, 0.18 m down.
         D from femur joint = sqrt(0.13^2 + 0.18^2) = 0.222 m, i.e. 83% of
         the femur+tibia reach of 0.267 m, so the knee is meaningfully bent.
         Ground clearance under the chassis becomes 0.18 - 0.0575 = 0.12 m.

       Angles, from the same closed-form IK as tools/verify_ik.py:
         coxa   0.0000 rad
         femur  1.6190 rad  ( 92.78 deg)   past vertical, hence the raised limit
         tibia -1.1834 rad  (-67.80 deg)   tibia hangs downward
  ==================================================================== -->
  <xacro:property name="stance_coxa_angle"  value="0.0"/>
  <xacro:property name="stance_femur_angle" value="0.2694"/>
  <xacro:property name="stance_tibia_angle" value="1.1837"/>

  <!-- Joint damping and friction.
       damping  : viscous, torque proportional to joint velocity, N*m*s/rad
       friction : static or Coulomb, a constant opposing torque, N*m

       These are NOT cosmetic. A completely undamped revolute chain is a
       marginally stable system for a discrete time solver: energy injected
       by a position controller has nowhere to go, and the joint oscillates
       or diverges. A small positive damping term is what makes an 18 DOF
       chain numerically well behaved.

       ===================================================================
       REVISED: friction 0.01 -> 3.0, damping 0.05 -> 0.5
       ===================================================================
       MEASURED SYMPTOM
         lf_femur_joint   now +1.8010   cmd +1.6212   delta -0.1798
       The femur sat 0.18 rad (10.3 deg) BELOW its commanded stance before
       the gait node ever published. Every femur, every leg, body about 7 cm
       low. The startup ramp then lifted the body back to design height
       against six feet held by friction at mu = 2.0, and levered the robot
       into the air.

       WHY IT SAGGED
       There is a window of one to two seconds between Gazebo starting to
       step physics and the controllers finishing activation. Nothing writes
       joint commands during it. With friction at 0.01 N*m against a femur
       holding torque of 2.45 N*m, the joints are free by a factor of 245,
       so the robot folds under its own weight almost instantly.

       WHY 3.0 N*m IS THE HONEST VALUE, NOT A FUDGE
       The old numbers modelled a frictionless ideal pivot. The robot does
       not use ideal pivots; it uses geared servos. A servo of the RDS5160
       class runs roughly 200:1 reduction, and gearbox friction is reflected
       to the output multiplied by that ratio. The practical consequence is
       familiar to anyone who has handled one: an UNPOWERED geared servo
       does not flop about, it holds its position. It is very nearly
       non-backdriveable.

       So the correct static friction is "at least the load it must hold
       without power". Peak femur torque is 2.45 N*m (see the torque
       analysis above); 3.0 N*m clears it with margin and reproduces the
       real behaviour: unpowered legs stay where they are put.

       EFFECT ON CONTROL
       None in position mode. gazebo_ros2_control realises position commands
       with SetPosition(), which overrides joint state directly, so joint
       friction cannot oppose it. This change therefore only acts during the
       unpowered activation window, which is exactly where it is needed.

       In EFFORT mode it does cost control authority: 3.0 N*m of the 5.0 N*m
       joint_effort budget is spent breaking friction, leaving 2.0 N*m. That
       is tight, and it is also true of the physical robot, which is the
       point. If effort-mode tuning later needs more headroom, the answer is
       a larger joint_effort backed by a servo that can actually deliver it,
       not a lower friction figure that flatters the simulation.

       Damping raised alongside it, 0.05 -> 0.5, for the same reason: a
       geared drive is viscous as well as frictional, and the extra damping
       costs about 0.5 N*m at 1 rad/s, which the gentle gait never reaches.

       ===================================================================
       REVISED AGAIN: friction 3.0 -> 1.5, from actual numbers this time
       ===================================================================
       3.0 was sized against "peak femur torque 2.45 N*m", which is the
       WORST CASE with the leg fully extended. That is not the stance case,
       and stance is the only case that matters here. Working it properly:

         total mass   1.310 body + 6 x 0.337 leg          = 3.332 kg
         weight                                            = 32.7 N
         standing on SIX legs                              = 5.45 N per foot
         femur lever arm, stance 0.28 minus coxa 0.15      = 0.13 m
         femur torque, unpowered, all six legs down        = 0.71 N*m

       0.71 N*m is what friction has to beat to stop the legs folding during
       the controller activation window. 3.0 is over four times that.

       WHY THE EXCESS IS HARMFUL IN EFFORT MODE
       Coulomb friction is stiction: the joint does not move at all until
       commanded torque exceeds it, then breaks free suddenly. With 3.0 N*m
       of stiction against a 1.42 N*m stance load (tripod gait: three legs
       carry everything, 10.9 N per foot), friction DOMINATES the dynamics.
       The PID winds up against a stuck joint, breaks through, overshoots,
       sticks again. Measured consequence: 6.9 deg of femur oscillation with
       no command at all, body sagging 2.8 cm, 8.8 deg of tilt while
       walking. No choice of gains fixes stick-slip; the friction itself has
       to come down.

       1.5 N*m keeps a 2x margin over the 0.71 N*m it must hold, and leaves
       7.0 - 1.5 - 1.42 = 4.1 N*m of authority for accelerating a swinging
       leg. That is a well-conditioned system rather than one where the
       dominant term is a modelling constant.

       In POSITION mode this change is invisible either way: SetPosition()
       overrides joint state, so friction never opposes it.
  -->
  <xacro:property name="joint_damping"  value="0.5"/>
  <xacro:property name="joint_friction" value="1.5"/>

  <!-- Foot contact friction. mu1 and mu2 are the ODE friction coefficients
       along the two tangential contact directions. Feet need HIGH friction
       or the tripod gait in Phase 8 will simply slip in place and go
       nowhere. -->
  <xacro:property name="foot_radius"   value="0.015"/>

  <!-- Raised from 1.2. A rubber foot on a hard floor is realistically 1.5 to
       2.0, so this is not an exaggeration, and generous friction removes one
       variable while the gait is being validated. If the robot later refuses
       to turn on the spot, THIS is the number to lower: excessive friction
       makes yaw fight the stance feet. -->
  <xacro:property name="foot_mu"       value="2.0"/>

  <!-- Per-foot ground reaction force sensors. OFF by default: enabling them
       requires disabling fixed-joint lumping on the six foot joints, which
       turns six merged rigid bodies into six real constraints and so is a
       change to the validated physics. Turn on when you need to answer "is
       that foot actually loaded, and is it slipping" rather than infer it
       from the gait clock. Full rationale in leg_macro.xacro. -->
  <xacro:property name="enable_foot_sensors" value="false"/>

  <!-- ====================================================================
       CAD MESHES

       POLICY: meshes are used for <visual> ONLY. <collision> and <inertial>
       stay primitives, permanently. This is not a shortcut, it is the
       normal division of labour:

         visual    : what a human looks at. Detail is free, accuracy is
                     cosmetic.
         collision : evaluated pairwise every physics step across 25 links.
                     A 9572 triangle body mesh here would cost roughly three
                     orders of magnitude more than a box and buy nothing,
                     because contact happens at the feet.
         inertial  : needs a closed manifold. body test.stl is not
                     watertight, so its mesh inertia is undefined. The box
                     formula is not an approximation of a better number, it
                     IS the better number here.

       PREREQUISITE: run tools/reorigin_meshes.py first. It bakes the layout
       sheet offset into the geometry and writes files with ROS safe names
       (no spaces, which break package:// resolution). After that the
       origins below are zero, apart from deliberate assembly offsets.

       mesh_scale converts the STL's millimetres to the URDF's metres. An
       STL carries no unit metadata whatsoever, so this factor IS the unit
       declaration for the whole model.
  ==================================================================== -->
  <xacro:property name="use_meshes" value="true"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>
  <xacro:property name="mesh_dir"
                  value="package://hexapod_description/meshes/visual"/>

  <!-- Assembly offset for the femur cover plate. femur_lower is 31.7 mm
       thick and centred on z = 0, so it spans -15.85 to +15.85 mm. The
       5 mm cover plate is anchored at its own z minimum, so placing it at
       z = +0.01585 m seats it exactly on top. If your CAD stacks them
       differently, this is the one number to change. -->
  <xacro:property name="femur_upper_z" value="0.01585"/>

  <!-- Visual nudges, applied on top of the re-origined meshes.
       reorigin_meshes.py anchors to the BOUNDING BOX, but the true pivot is
       usually inset from the end face by the servo horn or bearing boss.
       Adjust these by eye in RViz once, then never again. Metres. -->
  <xacro:property name="coxa_mesh_nudge"  value="0 0 0"/>
  <xacro:property name="femur_mesh_nudge" value="0 0 0"/>
  <xacro:property name="tibia_mesh_nudge" value="0 0 0"/>
  <xacro:property name="body_mesh_nudge"  value="0 0 0"/>

  <!-- ====================================================================
       INERTIA MACROS
       Closed form inertia tensors for primitive solids, about the solid's
       own centre of mass. These are EXACT, not estimates, which is exactly
       why building with primitives first gives a numerically sound
       simulation.

       Recall what the tensor means: mass resists linear acceleration, the
       inertia tensor resists ANGULAR acceleration, and it is direction
       dependent. Off diagonal terms are zero here because a box and a
       cylinder are symmetric about their own principal axes.
  ==================================================================== -->

  <!-- Solid cuboid, sides x, y, z, about its centre. -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1.0/12.0) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0) * mass * (x*x + z*z)}" iyz="0.0"
        izz="${(1.0/12.0) * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder whose axis of symmetry lies along X.
         Ixx = (1/2) m r^2                 about the long axis, easy to spin
         Iyy = Izz = (1/12) m (3r^2 + L^2) end over end, hard to spin
       That asymmetry is precisely the leg swing dynamics we must get
       right. -->
  <xacro:macro name="inertial_cylinder_x" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${0.5 * mass * radius * radius}" ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0) * mass * (3.0*radius*radius + length*length)}" iyz="0.0"
        izz="${(1.0/12.0) * mass * (3.0*radius*radius + length*length)}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid sphere about its centre. Used for the foot contact pad. -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${0.4 * mass * radius * radius}" ixy="0.0" ixz="0.0"
        iyy="${0.4 * mass * radius * radius}" iyz="0.0"
        izz="${0.4 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <!-- ====================================================================
       MATERIALS. RViz only; Gazebo uses its own gazebo material tags.
  ==================================================================== -->
  <material name="body_grey">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="coxa_orange">
    <color rgba="0.90 0.45 0.10 1.0"/>
  </material>
  <material name="femur_blue">
    <color rgba="0.15 0.45 0.80 1.0"/>
  </material>
  <material name="tibia_green">
    <color rgba="0.20 0.65 0.35 1.0"/>
  </material>
  <material name="foot_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

</robot>
