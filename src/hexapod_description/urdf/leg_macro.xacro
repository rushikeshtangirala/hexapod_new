<?xml version="1.0"?>
<!--
  leg_macro.xacro
  ==========================================================================
  ONE definition of a 3 DOF leg, instantiated six times.

  WHAT A XACRO MACRO IS AND WHY IT MATTERS HERE
  =============================================
  URDF is plain XML: no variables, no loops, no reuse. A literal URDF for
  this robot is about 1400 lines of near identical text. Xacro is a
  preprocessor that expands macros and evaluates ${...} expressions into
  that URDF before ROS ever sees it. Nothing at runtime knows xacro exists.

  The engineering argument is not "less typing". It is that six hand copied
  legs are six independent opportunities for a typo, and a typo in leg 4's
  femur origin produces a robot that walks in a curve for reasons that will
  take you a day to find. With a macro, all six legs are correct or all six
  are wrong, and "all six wrong" is a bug you find in ten seconds.

  KINEMATIC CHAIN
  ===============
    base_link
      -> [coxa joint : revolute about Z]   yaw, swings the leg fore and aft
        -> coxa_link
          -> [femur joint : revolute about Y]   pitch, lifts and lowers
            -> femur_link
              -> [tibia joint : revolute about Y]   pitch, extends
                -> tibia_link
                  -> [foot joint : FIXED]
                    -> foot_link   (contact sphere)

  FRAME CONVENTION, read this before debugging any sign error
  ===========================================================
  Every segment extends along its own local +X axis. So a joint's child
  origin is always (segment_length, 0, 0) in the parent's frame. One rule,
  no special cases.

  base_link follows REP 103: +X forward, +Y left, +Z up.

  Coxa axis is +Z. Positive coxa angle rotates the leg counter clockwise
  seen from above.

  Femur and tibia axes are +Y. By the right hand rule, rotation about +Y
  maps +X toward -Z. Therefore:

      POSITIVE femur angle moves the foot DOWNWARD.
      POSITIVE tibia angle moves the foot DOWNWARD and inward.

  This is stated explicitly because it is the number one source of sign bugs
  in the Phase 7 inverse kinematics. We keep the mathematically clean right
  handed axis and document the consequence, rather than flipping the axis to
  make it "feel right" and creating a left handed frame that breaks every
  standard rotation formula later.

  MIRRORING, why there is none
  ============================
  Left and right legs use this SAME macro with no mirrored axes. The mount
  yaw passed in by the caller rotates the entire chain into position, so in
  each leg's own local frame the geometry is identical. Mirroring joint axes
  instead is the classic hexapod mistake: three legs end up bending
  backwards and no amount of gait tuning fixes it.
==========================================================================  -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="hexapod_leg"
               params="prefix mount_x mount_y mount_z mount_yaw">

    <!-- ================================================================
         COXA. Attaches to the body, rotates about vertical Z.
    ================================================================ -->
    <link name="${prefix}_coxa_link">
      <!-- VISUAL: CAD mesh if available, primitive otherwise.
           xacro:if and xacro:unless are evaluated at expansion time, so the
           generated URDF contains exactly one of these. There is no runtime
           branch and no cost to keeping both paths in the source. Keeping
           the primitive path alive matters: if a mesh ever fails to load,
           flipping use_meshes to false gives you a working model instantly
           instead of an empty RViz and a guess. -->
      <xacro:if value="${use_meshes}">
        <visual>
          <origin xyz="${coxa_mesh_nudge}" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${mesh_dir}/coxa.stl" scale="${mesh_scale}"/>
          </geometry>
          <material name="coxa_orange"/>
        </visual>
      </xacro:if>
      <xacro:unless value="${use_meshes}">
        <visual>
          <!-- A URDF cylinder is defined along Z. Rotating +90 deg about Y
               maps Z onto X, aligning it with our +X segment convention.
               The xyz offset places the cylinder's CENTRE at half its
               length, so the link frame sits at the JOINT, not at the
               middle of the part. -->
          <origin xyz="${coxa_length/2} 0 0" rpy="0 ${pi/2} 0"/>
          <geometry>
            <cylinder radius="${coxa_radius}" length="${coxa_length}"/>
          </geometry>
          <material name="coxa_orange"/>
        </visual>
      </xacro:unless>

      <!-- COLLISION: always a primitive. See the policy note in
           common_properties.xacro. -->
      <collision>
        <origin xyz="${coxa_length/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="${coxa_radius}" length="${coxa_length}"/>
        </geometry>
      </collision>

      <!-- Inertia is about the segment's centre of mass, which for a
           uniform cylinder is its midpoint, hence the same x offset. -->
      <xacro:inertial_cylinder_x mass="${coxa_mass}"
                                 radius="${coxa_radius}"
                                 length="${coxa_length}">
        <origin xyz="${coxa_length/2} 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder_x>
    </link>

    <joint name="${prefix}_coxa_joint" type="revolute">
      <parent link="base_link"/>
      <child  link="${prefix}_coxa_link"/>
      <!-- This origin is the ONLY thing that differs between the six legs.
           The yaw splays the leg outward; everything downstream is
           identical. -->
      <origin xyz="${mount_x} ${mount_y} ${mount_z}" rpy="0 0 ${mount_yaw}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${coxa_lower}" upper="${coxa_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <!-- ================================================================
         FEMUR. The lift joint.
    ================================================================ -->
    <link name="${prefix}_femur_link">
      <!-- The femur is TWO STLs on ONE link: the bracket and its cover
           plate. A URDF link may carry any number of visual elements; they
           are simply unioned. This is the correct way to represent a
           multi part rigid assembly. Do NOT invent an extra link and a
           fixed joint for the cover plate: that adds a body to the physics
           tree for no kinematic reason. -->
      <xacro:if value="${use_meshes}">
        <visual>
          <origin xyz="${femur_mesh_nudge}" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${mesh_dir}/femur_lower.stl" scale="${mesh_scale}"/>
          </geometry>
          <material name="femur_blue"/>
        </visual>
        <visual>
          <origin xyz="0 0 ${femur_upper_z}" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${mesh_dir}/femur_upper.stl" scale="${mesh_scale}"/>
          </geometry>
          <material name="femur_blue"/>
        </visual>
      </xacro:if>
      <xacro:unless value="${use_meshes}">
        <visual>
          <origin xyz="${femur_length/2} 0 0" rpy="0 ${pi/2} 0"/>
          <geometry>
            <cylinder radius="${femur_radius}" length="${femur_length}"/>
          </geometry>
          <material name="femur_blue"/>
        </visual>
      </xacro:unless>

      <collision>
        <origin xyz="${femur_length/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="${femur_radius}" length="${femur_length}"/>
        </geometry>
      </collision>

      <xacro:inertial_cylinder_x mass="${femur_mass}"
                                 radius="${femur_radius}"
                                 length="${femur_length}">
        <origin xyz="${femur_length/2} 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder_x>
    </link>

    <joint name="${prefix}_femur_joint" type="revolute">
      <parent link="${prefix}_coxa_link"/>
      <child  link="${prefix}_femur_link"/>
      <!-- Sits at the far end of the coxa: the +X segment rule in action. -->
      <origin xyz="${coxa_length} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${femur_lower}" upper="${femur_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <!-- ================================================================
         TIBIA. The extend joint, carries the foot.
    ================================================================ -->
    <link name="${prefix}_tibia_link">
      <xacro:if value="${use_meshes}">
        <visual>
          <origin xyz="${tibia_mesh_nudge}" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${mesh_dir}/tibia.stl" scale="${mesh_scale}"/>
          </geometry>
          <material name="tibia_green"/>
        </visual>
      </xacro:if>
      <xacro:unless value="${use_meshes}">
        <visual>
          <origin xyz="${tibia_length/2} 0 0" rpy="0 ${pi/2} 0"/>
          <geometry>
            <cylinder radius="${tibia_radius}" length="${tibia_length}"/>
          </geometry>
          <material name="tibia_green"/>
        </visual>
      </xacro:unless>

      <collision>
        <origin xyz="${tibia_length/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="${tibia_radius}" length="${tibia_length}"/>
        </geometry>
      </collision>

      <xacro:inertial_cylinder_x mass="${tibia_mass}"
                                 radius="${tibia_radius}"
                                 length="${tibia_length}">
        <origin xyz="${tibia_length/2} 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder_x>
    </link>

    <joint name="${prefix}_tibia_joint" type="revolute">
      <parent link="${prefix}_femur_link"/>
      <child  link="${prefix}_tibia_link"/>
      <origin xyz="${femur_length} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${tibia_lower}" upper="${tibia_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <!-- ================================================================
         FOOT. Fixed frame plus contact sphere.

         WHY A SEPARATE FOOT LINK RATHER THAN JUST USING THE TIBIA TIP:

         1. It gives the IK in Phase 7 an explicit target frame. "Put the
            foot at (x, y, z)" becomes a TF lookup, not a hand derived
            offset.
         2. A SPHERE is the ideal contact primitive. Sphere to plane contact
            produces a single, well conditioned contact point. A cylinder or
            box end face produces a contact MANIFOLD that ODE resolves with
            multiple jittering points, the usual cause of a hexapod that
            buzzes and slowly slides across the world.

         A fixed joint is compiled away by most solvers, so this costs
         essentially nothing in performance.
    ================================================================ -->
    <link name="${prefix}_foot_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${foot_radius}"/>
        </geometry>
        <material name="foot_black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${foot_radius}"/>
        </geometry>
      </collision>

      <!-- Small but NON ZERO. A zero mass link carrying a collision
           geometry is a singular mass matrix waiting to happen. Some
           solvers reject it outright, others silently produce garbage
           contact forces. -->
      <xacro:inertial_sphere mass="0.010" radius="${foot_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_sphere>
    </link>

    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_tibia_link"/>
      <child  link="${prefix}_foot_link"/>
      <origin xyz="${tibia_length} 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ================================================================
         GAZEBO SPECIFIC PROPERTIES

         These gazebo tags are IGNORED by RViz and by every non Gazebo
         consumer of the URDF; they are stripped at parse time. That is what
         lets one description file serve both simulation and hardware.

         mu1 and mu2 : ODE Coulomb friction coefficients in the two
                       tangential contact directions. Feet need these HIGH.
                       With default friction the tripod gait will spin the
                       legs and the body will not move, which looks like a
                       gait bug but is a tribology problem.
         kp and kd   : contact stiffness and damping. kp too low means feet
                       sink into the ground. kp too high makes the contact
                       stiff and the solver ring. 1e6 and 1e2 is a sane
                       starting point for a sub 4 kg robot.
    ================================================================ -->
    <gazebo reference="${prefix}_foot_link">
      <xacro:if value="${demo_mode}"><gravity>0</gravity></xacro:if>
      <mu1>${foot_mu}</mu1>
      <mu2>${foot_mu}</mu2>

      <!-- CONTACT STIFFNESS AND DAMPING. See the long note on max_step_size
           in hexapod.world: kp and the physics timestep are a single joint
           decision.

           kp was 1e6, which against ~0.57 kg per foot gives a contact
           natural frequency of 211 Hz. Sampled at 1000 Hz that is under 5
           samples per oscillation, so the contact rings. Six ringing
           friction cones sum to a small pseudo-random force, and a robot
           standing still slowly yaws and slides away. That was the bug.

           5e4 puts the contact at about 47 Hz, i.e. ~21 samples per period
           at 1000 Hz, comfortably inside the stable region. Penetration
           under load becomes 5.6 N / 5e4 = 0.1 mm, which is invisible and
           entirely acceptable.

           kd 500 gives a damping ratio near 1.5 against
           c_crit = 2*sqrt(kp*m) = 337, so the contact is slightly
           overdamped: it settles without bouncing rather than oscillating
           about equilibrium. -->
      <kp>50000.0</kp>
      <kd>500.0</kd>

      <!-- Allowed penetration before corrective force. A small tolerance
           stops contacts flickering on and off between steps. -->
      <minDepth>0.001</minDepth>

      <!-- Maximum contact correction velocity. 0 forbids the solver from
           separating interpenetrating bodies at all, which makes feet stick
           and then release unpredictably. 0.01 m/s lets it resolve gently
           without the launch-into-orbit behaviour that a large value gives. -->
      <maxVel>0.01</maxVel>

      <material>Gazebo/Black</material>
    </gazebo>

    <!-- ================================================================
         FOOT CONTACT SENSOR.  OFF BY DEFAULT.  See enable_foot_sensors in
         common_properties.xacro.

         WHY YOU WANT IT

         The gait knows which feet it ASKED to put in stance. Nothing in the
         stack knows which feet are actually LOADED. Those are different
         things, and when the body drifts, the three candidate causes named
         in ARCHITECTURE.md section 4 (a foot slipping, a foot never making
         contact, and the solver injecting impulses) look identical from
         outside. With a force per foot each becomes a measurement:

           commanded stance mask vs measured contact mask -> missed feet
           sum of normal forces vs total weight           -> unloaded feet
           tangential / normal ratio vs mu                -> slip, directly

         Same principle as everything in tools/: make the failure mode
         measurable rather than guessable.

         WHY IT IS OFF BY DEFAULT, AND WHAT TURNING IT ON COSTS

         foot_joint is FIXED, so sdformat normally lumps foot_link into
         tibia_link and the foot ceases to exist as a body. A contact sensor
         cannot then be attached to it by name, because the collision gets
         renamed to something of the form
             <parent>_fixed_joint_lump__<child>_collision
         which is an implementation detail of the converter and a bad thing
         to hard-code.

         disableFixedJointLumping keeps foot_link as a real link, which
         makes the sensor straightforward but replaces a merged rigid body
         with an actual constraint, six of them. That is a change to the
         validated physics, so it is opt-in rather than silently on.

         TO USE:  set enable_foot_sensors to true in common_properties.xacro,
         rebuild, then confirm the topics exist before trusting anything:
             ros2 topic list | grep feet
             ros2 topic echo /hexapod/feet/lf/contact (add the once flag)
         If they are silent, dump the converted SDF and check the collision
         name rather than guessing:
             gz sdf -p <(xacro hexapod.urdf.xacro) | grep -A2 collision
    ================================================================ -->
    <xacro:if value="${enable_foot_sensors}">
      <gazebo reference="${prefix}_foot_joint">
        <disableFixedJointLumping>true</disableFixedJointLumping>
        <preserveFixedJoint>true</preserveFixedJoint>
      </gazebo>

      <gazebo reference="${prefix}_foot_link">
        <sensor name="${prefix}_foot_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100.0</update_rate>
          <contact>
            <collision>${prefix}_foot_link_collision</collision>
          </contact>
          <plugin name="${prefix}_foot_bumper" filename="libgazebo_ros_bumper.so">
            <ros>
              <namespace>/hexapod</namespace>
              <remapping>bumper_states:=feet/${prefix}/contact</remapping>
            </ros>
            <frame_name>${prefix}_foot_link</frame_name>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>

    <gazebo reference="${prefix}_coxa_link">
      <xacro:if value="${demo_mode}"><gravity>0</gravity></xacro:if>
      <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="${prefix}_femur_link">
      <xacro:if value="${demo_mode}"><gravity>0</gravity></xacro:if>
      <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="${prefix}_tibia_link">
      <xacro:if value="${demo_mode}"><gravity>0</gravity></xacro:if>
      <material>Gazebo/Green</material>
    </gazebo>

  </xacro:macro>

</robot>
