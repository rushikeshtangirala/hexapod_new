<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_gazebo</name>
  <version>0.1.0</version>
  <description>
    Gazebo Classic simulation assets for the hexapod: world files, physics
    tuning, and the launch files that start gzserver/gzclient and spawn the
    robot from hexapod_description. Simulation-only concerns live here so that
    hexapod_description stays hardware-agnostic.
  </description>
  <maintainer email="hexapod69420@gmail.com">Varun</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hexapod_description</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
